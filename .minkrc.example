# mink 配置示例
#
# 配置文件加载顺序（高优先级覆盖低）：
#   1. CLI --config TOML 字符串
#   2. <project>/.minkrc（项目级）
#   3. ~/.minkrc（用户级）
#   4. 环境变量
#   5. 默认值
#
# 所有字段可选，未设置的字段使用默认值或环境变量。

# ── API ─────────────────────────────────────────────────────
api_key = "sk-xxx"                          # API 密钥（也可用 DEEPSEEK_API_KEY 环境变量）
base_url = "https://api.deepseek.com/v1"    # API 端点（也可用 DEEPSEEK_BASE_URL 环境变量）
model = "flash"                             # 默认模型：flash / pro

# ── LLM ──────────────────────────────────────────────────────
max_tokens = 81920                          # 最大输出 token
max_turns = 40                              # 最大对话轮次
max_context = "1M"                          # 最大上下文 token（支持 K/M 后缀，如 500K, 1M）

# ── 超时 ─────────────────────────────────────────────────────
tool_timeout = 600                          # 工具超时（秒）
sub_agent_timeout = 300                     # 子代理超时（秒）
llm_first_event_timeout = 60               # 等待首个 LLM stream event 的秒数
llm_idle_timeout = 90                       # LLM stream 空闲超时（秒）
llm_wait_heartbeat = 30                     # 等待 LLM 响应时的提示间隔（秒，0=关闭）

# ── 上下文压缩 ───────────────────────────────────────────────
context_compact_pct = 85                    # 上下文使用率达到此百分比时触发压缩

# ── 日志 ─────────────────────────────────────────────────────
log_events = true                           # 是否记录 events.jsonl

# ── 输出格式 ─────────────────────────────────────────────────
# output_format = "human"                   # human / stream-json

# ── 搜索工具限制 ─────────────────────────────────────────────
max_search_files = 5000                     # Glob/Grep 最大遍历文件数
max_search_results = 1000                   # Grep 最大匹配结果行数

# ── 工具结果限制 ─────────────────────────────────────────────
# 也可通过 TOOL_RESULT_MAX_BYTES 和 FILE_WRITE_MAX_BYTES 环境变量设置

# ── 工具审批 ─────────────────────────────────────────────────
#[tools]
#approval_mode = "yolo"                    # yolo / write / always-ask
#
#[tools.approval]
#Bash = "prompt"                           # allow / deny / prompt

# ── 技能 ─────────────────────────────────────────────────────
#skills = ["debugging", "tdd"]

# ── 沙箱 ─────────────────────────────────────────────────────
#[sandbox]
#enabled = true
#backend = "auto"                         # nsjail / bwrap / sandbox-exec / off
#read_dirs = ["src"]
#write_dirs = ["src"]
#allow_bash = true
#allow_python = true
#allow_network = true
#allow_sub_agent = true
#max_memory_mb = 1024
#max_pids = 64
#timeout_secs = 600

