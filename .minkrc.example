# mink configuration file
# Place in ~/.minkrc (user-level) or <project>/.minkrc (project-level)
# Priority: CLI args > project .minkrc > user ~/.minkrc > defaults

# ── API ──────────────────────────────────────────────────────────────────

# API key (also via DEEPSEEK_API_KEY env)
# api_key = "sk-your-api-key"

# API base URL (also via DEEPSEEK_BASE_URL env)
# Default: https://api.deepseek.com/
# base_url = "https://api.deepseek.com/"

# ── Model ────────────────────────────────────────────────────────────────

# Model tier: "flash" or "pro"
# model = "flash"

# Max output tokens per response
# max_tokens = 81920

# Max agent turns per session
# max_turns = 40

# Max context token limit (supports K/M/G suffix)
# max_context = "1M"

# ── Timeouts ─────────────────────────────────────────────────────────────

# Tool execution timeout in seconds
# tool_timeout = 600

# Sub-agent execution timeout in seconds
# sub_agent_timeout = 300

# ── Behavior ─────────────────────────────────────────────────────────────

# Context compaction trigger percentage (default: 85)
# context_compact_pct = 85

# Enable event logging (default: true)
# log_events = true

# ── OS Process Sandbox ──────────────────────────────────────────────────
# When enabled, mink re-executes itself inside nsjail (Linux) /
# sandbox-exec (macOS) / bubblewrap (fallback) for OS-level process
# isolation.
#
# [sandbox]
# enabled = false
# backend = "auto"      # "auto" | "nsjail" | "bwrap" | "sandbox-exec" | "off"
#
# # File-system whitelist (relative paths resolve against project root)
# read_dirs = ["src", "tests", "docs"]
# write_dirs = ["src"]
#
# # Tool restrictions
# allow_bash = true
# bash_allow_commands = ["ls", "cat", "cargo", "python", "rg", "diff"]
# allow_python = true
# allow_network = true
# allow_sub_agent = true
#
# # Resource limits (Linux nsjail cgroup only)
# max_memory_mb = 1024
# max_pids = 64
# timeout_secs = 600

# ── CPython WASI Sandbox (PythonSandbox tool) ────────────────────────────
# Runs Python code in a wasmtime + CPython WASI sandbox with WASI-level
# isolation. No subprocess, no network, no C extensions.
#
# The python.wasm binary can be downloaded from:
#   https://github.com/brettcannon/cpython-wasi-build/releases
#
# Download example:
#   curl -sL "https://github.com/brettcannon/cpython-wasi-build/releases/download/v3.13.13/python-3.13.13-wasi_sdk-24.zip" -o python-wasi.zip
#   unzip python-wasi.zip -d cpython-wasi
#
# Required directory structure:
#   cpython-wasi/
#   ├── python.wasm          # ~29MB
#   ├── lib/python3.13/      # Standard library
#   └── LICENSE
#
[sandbox_python]
# Enable the PythonSandbox tool (default: disabled)
enable = true

# Path to python.wasm (relative to project root or absolute)
wasm_path = "cpython-wasi/python.wasm"

# Directory containing lib/python3.13/ (standard library)
stdlib_dir = "cpython-wasi"

# Timeout in seconds for each Python script execution (default: 30)
timeout = 30

# Directories allowed for read access (relative to project root or absolute)
# Scripts can read files in these directories.
read_dirs = ["./data"]

# Directories allowed for write access (relative to project root or absolute)
# Scripts can create and modify files in these directories.
# Use ["./"] to grant write access to the entire project root.
write_dirs = ["./output"]

# Additional Python package directories mounted at /packages/ inside the sandbox
# Pure Python packages can be loaded from here via PYTHONPATH.
# package_dirs = ["./packages"]

# ── Tool Approval ───────────────────────────────────────────────────────
# [tools]
# approval_mode = "yolo"     # "yolo" | "write" | "always-ask"
#
# # Per-tool override:
# [tools.approval]
# Edit = "prompt"
# Bash = "deny"
