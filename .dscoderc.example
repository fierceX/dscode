# dscode configuration file
# Place in ~/.dscoderc (user-level) or <project>/.dscoderc (project-level)
# Priority: CLI args > project .dscoderc > user ~/.dscoderc > defaults

# ── API ────────────────────────────────────────────────────

# API key (also via DEEPSEEK_API_KEY env)
# api_key = "sk-xxx"

# API base URL (also via DEEPSEEK_BASE_URL env)
# base_url = "https://api.deepseek.com/v1"

# ── Model ──────────────────────────────────────────────────

# Model tier: "flash" or "pro"
# model = "flash"

# Max output tokens per response
# max_tokens = 81920

# Max agent turns per session
# max_turns = 40

# Max context token limit (supports K/M/G suffix)
# max_context = "1M"

# ── Timeouts ───────────────────────────────────────────────

# Tool execution timeout in seconds
# tool_timeout = 600

# Sub-agent execution timeout in seconds
# sub_agent_timeout = 300

# ── Behavior ───────────────────────────────────────────────

# Context compaction trigger percentage (default: 85)
# context_compact_pct = 85

# Enable event logging (default: true)
# log_events = true

# ── Sandbox ────────────────────────────────────────────────
# When enabled, dscode automatically re-executes itself inside
# nsjail (Linux) / sandbox-exec (macOS) / bubblewrap (fallback).
#
# Platform capabilities: see docs/USAGE.md 沙箱配置 > 平台差异
#
#   Linux: read + write restrictions, network isolation, resource limits
#   macOS: write restrictions only (reads handled at app-level)
#
# [sandbox]
# enabled = false
# backend = "auto"      # "auto" | "nsjail" | "bwrap" | "sandbox-exec" | "off"

# File-system whitelist (relative paths resolve against project root)
# read_dirs = ["src", "tests", "docs"]     # macOS: 激活沙箱但读取限制不生效
# write_dirs = ["src"]

# Tool restrictions
# allow_bash = true
# bash_allow_commands = ["ls", "cat", "cargo", "python", "rg", "diff"]
# allow_python = true
# allow_network = true    # false = total network isolation (Linux only)
# allow_sub_agent = true

# Resource limits (Linux nsjail cgroup only)
# max_memory_mb = 1024
# max_pids = 64
# timeout_secs = 600
