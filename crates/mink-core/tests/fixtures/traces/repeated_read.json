{
  "name": "repeated-read",
  "source": "生产轨迹分析：同一份报告文件单会话整读 15 次（其中 6 次用 path_sel/limit/offset 猜测参数）；全库同文件重复读 1,881 次",
  "setup": {
    "files": {
      "compliance_report.md": "{{REPORT_FILE}}"
    },
    "config": {}
  },
  "steps": [
    {
      "tool": "Read",
      "input": {
        "path": "compliance_report.md"
      }
    },
    {
      "tool": "Read",
      "input": {
        "path": "compliance_report.md"
      }
    },
    {
      "tool": "Read",
      "input": {
        "path": "compliance_report.md:1-50"
      }
    },
    {
      "tool": "Read",
      "input": {
        "path": "compliance_report.md:1-50"
      }
    }
  ],
  "asserts": [
    {
      "after_step": 0,
      "success": true,
      "contains": "1:"
    },
    {
      "after_step": 1,
      "success": true,
      "contains": "unchanged, no edits since"
    },
    {
      "after_step": 2,
      "success": true,
      "contains": "unchanged, no edits since"
    },
    {
      "after_step": 3,
      "success": true,
      "contains": "unchanged, no edits since"
    }
  ]
}
